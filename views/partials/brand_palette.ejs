<%
// Light Mode Colors
const lightMode = [
  { hex: '#1b1b1b', name: 'text-primary', usage: 'Primary text, headings' },
  { hex: '#333333', name: 'text-secondary', usage: 'Body text, captions' },
  { hex: '#F5F3F5', name: 'background', usage: 'Main page background' },
  { hex: '#150050', name: 'primary', usage: 'Brand anchor, nav, buttons' },
  { hex: '#3f0071', name: 'secondary', usage: 'Hover states, accents' },
  { hex: '#C88304', name: 'highlight', usage: 'CTAs, links, emphasis' },
  { hex: '#0072af', name: 'accent-cool', usage: 'Info states, secondary actions' },
  { hex: '#582707', name: 'accent-warm', usage: 'Alerts, warnings' }
];

// Dark Mode Colors
const darkMode = [
  { hex: '#F5F3F5', name: 'text-primary', usage: 'Primary text, headings' },
  { hex: '#B8B5B8', name: 'text-secondary', usage: 'Body text, captions' },
  { hex: '#0D0D12', name: 'background', usage: 'Main page background' },
  { hex: '#1E0A5C', name: 'primary', usage: 'Brand anchor, surfaces' },
  { hex: '#5A1A9E', name: 'secondary', usage: 'Elevated surfaces, accents' },
  { hex: '#E09A1A', name: 'highlight', usage: 'CTAs, links, emphasis' },
  { hex: '#54B7EC', name: 'accent-cool', usage: 'Info states, secondary actions' },
  { hex: '#F07C52', name: 'accent-warm', usage: 'Alerts, attention' }
];

// Semantic Tokens
const semanticTokens = [
  { light: '#22C55E', dark: '#4ADE80', name: 'success', usage: 'Success states' },
  { light: '#EAB308', dark: '#FACC15', name: 'warning', usage: 'Warning states' },
  { light: '#EF4444', dark: '#F87171', name: 'error', usage: 'Error states' },
  { light: '#0072af', dark: '#54B7EC', name: 'info', usage: 'Info states' }
];

// Helper function to determine text color based on background luminance
function getTextColor(hex) {
  const r = parseInt(hex.slice(1, 3), 16);
  const g = parseInt(hex.slice(3, 5), 16);
  const b = parseInt(hex.slice(5, 7), 16);
  const luminance = (0.299 * r + 0.587 * g + 0.114 * b) / 255;
  return luminance > 0.5 ? '#150050' : '#F5F3F5';
}
%>

<section id="brand-palette">
  <!-- Light Mode Section -->
  <div class="palette-section light-section">
    <div class="palette-container">
      <h1>{k} Brand System</h1>
      <p class="palette-subtitle">kjon.life · Functional palette</p>
      
      <h2>Light Mode</h2>
      <div class="color-grid">
        <% lightMode.forEach(color => { %>
          <div class="color-card" style="background-color: <%= color.hex %>;">
            <div class="color-preview"></div>
            <div class="color-info" style="color: <%= getTextColor(color.hex) %>;">
              <h3 class="color-name"><%= color.name %></h3>
              <p class="color-hex"><%= color.hex %></p>
              <p class="color-usage"><%= color.usage %></p>
            </div>
          </div>
        <% }); %>
      </div>

      <div class="color-strip">
        <% lightMode.forEach(color => { %>
          <div class="color-strip-item" style="background-color: <%= color.hex %>;" title="<%= color.name %>: <%= color.hex %>"></div>
        <% }); %>
      </div>
    </div>
  </div>

  <!-- Dark Mode Section -->
  <div class="palette-section dark-section">
    <div class="palette-container">
      <h2>Dark Mode</h2>
      <div class="color-grid">
        <% darkMode.forEach(color => { %>
          <div class="color-card" style="background-color: <%= color.hex %>;">
            <div class="color-preview"></div>
            <div class="color-info" style="color: <%= getTextColor(color.hex) %>;">
              <h3 class="color-name"><%= color.name %></h3>
              <p class="color-hex"><%= color.hex %></p>
              <p class="color-usage"><%= color.usage %></p>
            </div>
          </div>
        <% }); %>
      </div>

      <div class="color-strip">
        <% darkMode.forEach(color => { %>
          <div class="color-strip-item" style="background-color: <%= color.hex %>;" title="<%= color.name %>: <%= color.hex %>"></div>
        <% }); %>
      </div>
    </div>
  </div>

  <!-- Semantic Tokens -->
  <div class="palette-section semantic-section">
    <div class="palette-container">
      <h2>Semantic Tokens</h2>
      <div class="color-grid">
        <% semanticTokens.forEach(token => { %>
          <div class="semantic-card">
            <div class="semantic-preview">
              <div class="semantic-half light" style="background-color: <%= token.light %>;"></div>
              <div class="semantic-half dark" style="background-color: <%= token.dark %>;"></div>
            </div>
            <div class="semantic-info">
              <h3 class="color-name"><%= token.name %></h3>
              <p class="color-hex">L: <%= token.light %> / D: <%= token.dark %></p>
              <p class="color-usage"><%= token.usage %></p>
            </div>
          </div>
        <% }); %>
      </div>
    </div>
  </div>

  <!-- SCSS Export Reference -->
  <div class="palette-section code-section">
    <div class="palette-container">
      <h2>SCSS Variables</h2>
      <pre class="code-block"><code>// Light Mode
$light-brand-colors: (
  text-primary: #1b1b1b,
  text-secondary: #333333,
  background: #F5F3F5,
  primary: #150050,
  secondary: #3f0071,
  highlight: #C88304,
  complementary-accent-cool: #0072af,
  complementary-accent-warm: #582707
);

// Dark Mode
$dark-brand-colors: (
  text-primary: #F5F3F5,
  text-secondary: #B8B5B8,
  background: #0D0D12,
  primary: #1E0A5C,
  secondary: #5A1A9E,
  highlight: #E09A1A,
  complementary-accent-cool: #54B7EC,
  complementary-accent-warm: #F07C52
);

// Semantic (mode-aware)
$semantic-colors-light: (
  success: #22C55E,
  warning: #EAB308,
  error: #EF4444,
  info: #0072af
);

$semantic-colors-dark: (
  success: #4ADE80,
  warning: #FACC15,
  error: #F87171,
  info: #54B7EC
);</code></pre>
    </div>
  </div>
</section>

