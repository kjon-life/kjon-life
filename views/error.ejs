<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('partials/head') %>
    <meta name="robots" content="noindex">
  </head>

  <body>
    <main>
      <section id="error">
        <div class="error-container">
          <a class="error-mark" href="/" aria-label="kjon.life home">{k}</a>
          <% if (status === 404) { %>
            <h1>This page isn't here.</h1>
            <p>The address may be mistyped, or the page has moved.</p>
          <% } else { %>
            <h1>Something broke on our side.</h1>
            <p>Give it a moment, then try again.</p>
          <% } %>
          <a class="button-primary" href="/">Back to kjon.life</a>

          <%# the stack is only passed in development; see the error handler in app.js %>
          <% if (error.stack) { %>
            <div class="error-output">
              <pre class="error-status"><%= status %> <%= message %></pre>
              <pre class="error-stack"><%= error.stack %></pre>
            </div>
          <% } %>
        </div>
      </section>
    </main>
  </body>
</html>
